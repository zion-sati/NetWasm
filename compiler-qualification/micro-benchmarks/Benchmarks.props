<Project>
  <!-- The dotnet/performance micro-benchmarks, the attribute stand-ins and the generated case table, shared by
       every runtime's build. run.py passes DotnetPerformanceSource (the checkout's src directory) and
       MicroBenchmarkGenerated (the directory holding the case table and the exclusions as Compile removals). -->
  <PropertyGroup>
    <Micro>$(MSBuildThisFileDirectory)</Micro>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS8618;CS8632;CS1998;CS0618;CS8981;SYSLIB0011</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/runtime/**/*.cs" />
    <!-- The vector library benchmarks, since NetWasm lowers Vector128<T> and Vector<T> to Wasm SIMD. -->
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.Runtime.Intrinsics/**/*.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.Numerics.Vectors/**/*.cs" />
    <!-- The span and string benchmarks, which take upstream's vectorized SpanHelpers, SearchValues and Ascii. -->
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.Memory/**/*.cs" />
    <!-- async methods, ValueTask and channels, the Async family. -->
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.Threading.Tasks/**/*.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.Threading.Tasks.Extensions/**/*.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.Threading.Channels/**/*.cs" />
    <!-- Suites whose task-returning benchmarks join the Async family; the generator takes no others from them. -->
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.IO.Pipelines/**/*.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.Threading/Perf.SemaphoreSlim.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.IO/TextReaderReadLineTests.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.IO/StreamReaderReadToEndTests.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.IO/StringReaderReadToEndTests.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.IO/StreamReaderReadLineTests.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.IO/StringReaderReadLineTests.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.IO/MemoryStreamTests.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/libraries/System.IO/MemoryStreamChunkedTests.cs" />
    <Compile Include="$(DotnetPerformanceSource)/benchmarks/micro/Categories.cs" />
    <Compile Include="$(Micro)shim/*.cs;$(Micro)runner/*.cs;$(MicroBenchmarkGenerated)/Benchmarks.g.cs" />
    <!-- NetWasm's own workloads, such as issue #166's prime search. -->
    <Compile Include="$(Micro)workloads/*.cs" />
  </ItemGroup>
  <Import Project="$(MicroBenchmarkGenerated)/Exclusions.g.props" />
</Project>
