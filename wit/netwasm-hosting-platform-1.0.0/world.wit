package netwasm:hosting-platform@1.0.0;

/// Exact WASI 0.3 provider surface NetWasm's JavaScript hosts supply.
///
/// This is a catalog world, not an application world. Applications retain only
/// their own reachable imports; Hosting uses this world at build time to
/// project reviewed provider metadata and signatures.
world wasi {
    import wasi:cli/environment@0.3.2;
    import wasi:cli/exit@0.3.2;
    import wasi:cli/stderr@0.3.2;
    import wasi:cli/stdin@0.3.2;
    import wasi:cli/stdout@0.3.2;
    import wasi:cli/terminal-input@0.3.2;
    import wasi:cli/terminal-output@0.3.2;
    import wasi:cli/terminal-stderr@0.3.2;
    import wasi:cli/terminal-stdin@0.3.2;
    import wasi:cli/terminal-stdout@0.3.2;
    import wasi:clocks/monotonic-clock@0.3.2;
    import wasi:clocks/system-clock@0.3.2;
    import wasi:filesystem/preopens@0.3.2;
    import wasi:filesystem/types@0.3.2;
    import wasi:http/client@0.3.2;
    import wasi:http/types@0.3.2;
    import wasi:random/insecure-seed@0.3.2;
    import wasi:random/insecure@0.3.2;
    import wasi:random/random@0.3.2;
    import wasi:sockets/ip-name-lookup@0.3.2;
    import wasi:sockets/types@0.3.2;
}
