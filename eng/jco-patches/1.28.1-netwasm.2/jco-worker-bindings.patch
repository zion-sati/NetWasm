+#[cfg(test)]
+mod tests {
+    use super::*;
+    use wit_parser::{Docs, Function, FunctionKind, Span, Stability};
+
+    fn function(name: &str) -> Function {
+        Function {
+            name: name.to_string(),
+            kind: FunctionKind::Freestanding,
+            params: Vec::new(),
+            result: None,
+            docs: Docs::default(),
+            stability: Stability::default(),
+            span: Span::default(),
+            external_id: None,
+        }
+    }
+
+    #[test]
+    fn export_metadata_retains_original_component_names() {
+        let mut bindgen = EsmBindgen::default();
+        bindgen.add_export_binding(
+            Some("interface-0"),
+            "local_interface".into(),
+            "value".into(),
+            &function("value"),
+        );
+        bindgen.add_export_binding(
+            None,
+            "local_root".into(),
+            "root0".into(),
+            &function("root-0"),
+        );
+
+        assert_eq!(
+            bindgen.exports(),
+            vec![("interface0", "interface-0"), ("root0", "root-0")]
+        );
+    }
+
+    #[test]
+    fn qualified_export_alias_retains_original_component_name() {
+        let mut bindgen = EsmBindgen::default();
+        bindgen.add_export_binding(
+            Some("example:worker/math-api@1.0.0"),
+            "local_interface".into(),
+            "value".into(),
+            &function("value"),
+        );
+        bindgen.populate_export_aliases();
+
+        assert_eq!(
+            bindgen.exports(),
+            vec![
+                ("mathApi", "example:worker/math-api@1.0.0"),
+                (
+                    "example:worker/math-api@1.0.0",
+                    "example:worker/math-api@1.0.0"
+                ),
+            ]
+        );
+    }
+
+    #[test]
+    #[should_panic(expected = "normalize to the same JavaScript name interface0")]
+    fn colliding_interface_names_are_rejected() {
+        let mut bindgen = EsmBindgen::default();
+        bindgen.add_export_binding(
+            Some("interface-0"),
+            "first".into(),
+            "value".into(),
+            &function("value"),
+        );
+        bindgen.add_export_binding(
+            Some("interface0"),
+            "second".into(),
+            "value".into(),
+            &function("value"),
+        );
+    }
+}
