<Project>
  <!--
    NetWasm's own tooling is AOT-compatible: the compiler also runs ahead-of-time
    compiled in the browser, and reflection is unsupported in NetWasm. The trim
    and AOT analyzers report reflection, such as a JsonSerializer call without a
    source-generated contract, and every build treats warnings as errors.
  -->
  <PropertyGroup Condition="'$(IsAotCompatible)' == '' and
                            ($([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(NetWasmRepositorySourceRoot)src')) or
                             $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(NetWasmRepositorySourceRoot)tools'))) and
                            $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <Target Name="UseCanonicalNetWasmSourceLinkRepository"
          AfterTargets="InitializeSourceControlInformationFromSourceControlManager"
          BeforeTargets="TranslateGitHubUrlsInSourceControlInformation"
          Condition="'@(SourceRoot)' != ''">
    <!--
      SourceLink initializes SourceRoot metadata from the checkout's Git remote,
      even when RepositoryUrl is already pinned for the package. Normalize both
      inputs before the GitHub provider generates its document map so portable
      PDBs are independent of a developer or CI clone URL.
    -->
    <PropertyGroup>
      <ScmRepositoryUrl>$(RepositoryUrl)</ScmRepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
      <SourceRoot Update="@(SourceRoot)"
                  RepositoryUrl="$(RepositoryUrl)"
                  ScmRepositoryUrl="$(RepositoryUrl)" />
    </ItemGroup>
  </Target>
</Project>
