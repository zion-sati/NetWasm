{
  "$schema": "http://json.schemastore.org/template",
  "author": "NetWasm",
  "classifications": [ "NetWasm", "Wasm", "Console" ],
  "identity": "NetWasm.Templates.App",
  "name": "NetWasm Application",
  "shortName": "netwasm-app",
  "sourceName": "NetWasmProject",
  "preferNameDirectory": true,
  "symbols": {
    "host": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "JavaScript module host",
      "description": "Create a JavaScript module whose [JSExport] methods run on the page or in a Web Worker.",
      "defaultValue": "none",
      "choices": [
        {
          "choice": "none",
          "description": "Create no JavaScript module."
        },
        {
          "choice": "page",
          "description": "Run the module on the page, where its imports can use the DOM."
        },
        {
          "choice": "worker",
          "description": "Run the module in a Web Worker and call it asynchronously."
        }
      ]
    },
    "worker": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "WIT worker output",
      "description": "Create a browser Web Worker described by WIT.",
      "defaultValue": "none",
      "choices": [
        {
          "choice": "none",
          "description": "Create the standard NetWasm application."
        },
        {
          "choice": "wit",
          "description": "Create a portable WIT Web Worker."
        }
      ]
    }
  },
  "sources": [
    {
      "source": "console",
      "target": ".",
      "condition": "(worker == \"none\" && host == \"none\")"
    },
    {
      "source": "worker-common",
      "target": ".",
      "condition": "((worker == \"wit\" && host == \"none\") || host == \"worker\")"
    },
    {
      "source": "wit",
      "target": ".",
      "condition": "(worker == \"wit\" && host == \"none\")"
    },
    {
      "source": "host-page",
      "target": ".",
      "condition": "(host == \"page\")"
    },
    {
      "source": "host-worker",
      "target": ".",
      "condition": "(host == \"worker\")"
    }
  ],
  "tags": {
    "language": "C#",
    "type": "project"
  }
}
