<Project Sdk="NetWasm.Sdk/0.4.2">
  <PropertyGroup>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>worker</NetWasmJavaScriptHosts>
    <TargetFramework>netwasm0.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <NetWasmJavaScriptModule Include="notifications.mjs"
                             Module="netwasm:worker-template/notifications@1.0.0" />
    <Content Include="index.html;app.mjs" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
