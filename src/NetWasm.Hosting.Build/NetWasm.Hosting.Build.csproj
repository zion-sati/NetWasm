<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NetWasm.Hosting.Build</AssemblyName>
    <RootNamespace>NetWasm.Hosting.Build</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>NetWasm.Hosting.Build</PackageId>
    <Version>0.4.2-preview.1</Version>
    <Description>Build-time composition for public NetWasm Hosting and Toolchain packages.</Description>
    <PackageTags>netwasm;hosting;msbuild;wasm</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);NetWasmHostingBuildCollectDependencies</TargetsForTfmSpecificBuildOutput>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <NetWasmPackTaskProjectPath>$(MSBuildProjectDirectory)/../NetWasm.Sdk.Pack/NetWasm.Sdk.Pack.csproj</NetWasmPackTaskProjectPath>
    <NetWasmPackTaskOutput Condition="'$(BaseOutputPath)' != ''">$([System.IO.Path]::Combine('$(BaseOutputPath)', '$(Configuration)', 'net10.0', 'NetWasm.Sdk.Pack.dll'))</NetWasmPackTaskOutput>
    <NetWasmPackTaskOutput Condition="'$(BaseOutputPath)' == ''">$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '../NetWasm.Sdk.Pack/bin', '$(Configuration)', 'net10.0', 'NetWasm.Sdk.Pack.dll'))</NetWasmPackTaskOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(NetWasmPackTaskProjectPath)"
                      ReferenceOutputAssembly="false"
                      BuildReference="true"
                      PrivateAssets="all" />
    <ProjectReference Include="../NetWasm.Hosting/NetWasm.Hosting.csproj" PrivateAssets="all" />
    <ProjectReference Include="../NetWasm.Toolchain/NetWasm.Toolchain.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core"
                      Version="18.0.2"
                      PrivateAssets="all"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSES/LicenseRef-NetWasm-Community-1.0.txt"
          Pack="true"
          PackagePath="LICENSE.txt"
          Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="buildTransitive/NetWasm.Hosting.Build.targets"
          Pack="true"
          PackagePath="buildTransitive/NetWasm.Hosting.Build.targets" />
    <None Include="$(TargetDir)$(AssemblyName).deps.json"
          Pack="true"
          PackagePath="$(BuildOutputTargetFolder)/$(TargetFramework)/" />
  </ItemGroup>

  <Target Name="NetWasmHostingBuildCollectDependencies"
          DependsOnTargets="ResolveReferences"
          Returns="@(BuildOutputInPackage)">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            TargetPath="%(Filename)%(Extension)"
                            Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="NetWasm.Sdk.Pack.DeterministicPackageArchiveTask"
             AssemblyFile="$(NetWasmPackTaskOutput)" />

  <Target Name="ResolveNetWasmHostingBuildPackTask"
          BeforeTargets="Pack"
          Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="$(NetWasmPackTaskProjectPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration);BaseOutputPath=$(BaseOutputPath);BaseIntermediateOutputPath=$(BaseIntermediateOutputPath)" />
  </Target>

  <Target Name="CanonicalizeNetWasmHostingBuildPackage"
          AfterTargets="GenerateNuspec"
          Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <NetWasmHostingBuildPackagePath>$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(PackageVersion).nupkg'))</NetWasmHostingBuildPackagePath>
    </PropertyGroup>
    <DeterministicPackageArchiveTask PackagePath="$(NetWasmHostingBuildPackagePath)"
                                     PackageId="$(PackageId)"
                                     PackageVersion="$(PackageVersion)"
                                     SourceDateEpoch="$(SOURCE_DATE_EPOCH)" />
  </Target>
</Project>
