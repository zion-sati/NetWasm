<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Native AOT nwc collects with Satori (VSadov/Satori, MIT): on a DoomSharp compile it
       peaks at 0.35 of Server GC's memory at O0 and 0.45 at O3, as fast at O0 and 5% slower
       at O3 (2026-11-07). This SDK takes ILC and the NativeAOT runtime from its packages. -->
  <Sdk Name="PublishWithSatoriGC" Version="11.0.0-satori.42242472725.1" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nwc</AssemblyName>
    <RootNamespace>NetWasm.Compiler.Cli</RootNamespace>
    <!-- The shipped nwc is a self-contained Native AOT executable published for net11.0;
         it needs no installed runtime. The net10.0 build serves tests and tools that run
         nwc.dll on the .NET 10 runtime. -->
    <TargetFramework />
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Version>0.4.2</Version>
    <IsPackable>false</IsPackable>
    <!-- The compiler reads no culture data, so a Native AOT nwc needs no ICU on the host. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- On the .NET 10 runtime that runs nwc.dll: the analysis and emission workers allocate
         concurrently, and per-core heaps keep them from stopping each other for every
         collection. A compilation is short, so its heaps are sized for speed rather than
         adapted down to save memory. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
    <!-- Satori's packages are a .NET 11 runtime, so only the net11.0 nwc takes them. -->
    <UseSatoriGC Condition="'$(TargetFramework)' != 'net11.0'">false</UseSatoriGC>
  </PropertyGroup>
  <!-- MSVC's linker stamps the time into each image unless /Brepro, which a
       repeatable Native AOT nwc needs. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' AND $(RuntimeIdentifier.StartsWith('win-'))">
    <LinkerArg Include="/Brepro" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NetWasm.Compiler/NetWasm.Compiler.csproj" />
    <ProjectReference Include="../NetWasm.Compiler.ComponentModel/NetWasm.Compiler.ComponentModel.csproj" />
  </ItemGroup>
</Project>
