{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "netwasm.execution/1",
  "description": "Local execution descriptor. Never publish with an application. Local paths require semantic validation before use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "buildFingerprint", "deploymentManifestPath",
    "deploymentManifestSha256", "hostingVersion", "hostExecutablePath",
    "launcherPath"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "buildFingerprint": { "$ref": "#/$defs/sha256" },
    "deploymentManifestPath": { "$ref": "#/$defs/localPath" },
    "deploymentManifestSha256": { "$ref": "#/$defs/sha256" },
    "hostingVersion": { "type": "string", "pattern": "\\S" },
    "hostExecutablePath": { "$ref": "#/$defs/localPath" },
    "launcherPath": { "$ref": "#/$defs/localPath" }
  },
  "$defs": {
    "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
    "localPath": {
      "type": "string",
      "pattern": "\\S",
      "description": "Fully qualified path on the development host, without NUL. Checked by the native path validator."
    }
  }
}
