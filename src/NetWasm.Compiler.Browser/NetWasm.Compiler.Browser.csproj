<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>NetWasm.Compiler.Browser</PackageId>
    <Version>0.4.2</Version>
    <Description>Virtual-input NetWasm compiler adapter for isolated browser and WebAssembly hosts.</Description>
    <PackageTags>netwasm;compiler;browser;wasm</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);NetWasmCompilerBrowserCollectDependencies</TargetsForTfmSpecificBuildOutput>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NetWasm.Compiler/NetWasm.Compiler.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSES/LicenseRef-NetWasm-Community-1.0.txt"
          Pack="true"
          PackagePath="LICENSE.txt"
          Visible="false" />
    <None Include="README.md"
          Pack="true"
          PackagePath="README.md" />
    <None Include="$(TargetDir)$(AssemblyName).deps.json"
          Pack="true"
          PackagePath="lib/$(TargetFramework)/" />
  </ItemGroup>
  <Target Name="NetWasmCompilerBrowserCollectDependencies"
          DependsOnTargets="ResolveReferences"
          Returns="@(BuildOutputInPackage)">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            TargetPath="%(Filename)%(Extension)"
                            Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>
  <Import Project="../../eng/NetWasm.DeterministicPackageArchive.targets" />
</Project>
