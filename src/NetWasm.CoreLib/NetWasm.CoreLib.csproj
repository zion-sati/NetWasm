  <!-- NetWasm's product version for Environment.Version and RuntimeInformation. The release tooling
       projects each release version into eng/NetWasm.ReleaseVersion.txt before packages build.
       NetWasmProductVersion.cs keeps a fallback for sources compiled without this project. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);NETWASM_PRODUCT_VERSION_GENERATED</DefineConstants>
  </PropertyGroup>
  <Target Name="NetWasmGenerateProductVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_NetWasmProductVersionSource>$(IntermediateOutputPath)NetWasmProductVersion.g.cs</_NetWasmProductVersionSource>
    </PropertyGroup>
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)../../eng/NetWasm.ReleaseVersion.txt">
      <Output TaskParameter="Lines" PropertyName="_NetWasmReleaseVersion" />
    </ReadLinesFromFile>
    <Error Condition="'$(_NetWasmReleaseVersion.Trim())' == ''"
           Text="eng/NetWasm.ReleaseVersion.txt does not name a release version." />
    <ItemGroup>
      <_NetWasmProductVersionLine Include="namespace System%3B" />
      <_NetWasmProductVersionLine Include="internal static partial class NetWasmProductVersion" />
      <_NetWasmProductVersionLine Include="{" />
      <_NetWasmProductVersionLine Include="    internal const string Value = &quot;$(_NetWasmReleaseVersion.Trim())&quot;%3B" />
      <_NetWasmProductVersionLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_NetWasmProductVersionSource)" Lines="@(_NetWasmProductVersionLine)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_NetWasmProductVersionSource)" />
      <FileWrites Include="$(_NetWasmProductVersionSource)" />
    </ItemGroup>
  </Target>
</Project>
