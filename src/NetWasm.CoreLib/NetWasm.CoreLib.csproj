<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NetWasm.CoreLib</AssemblyName>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStandardLibraries>true</NoStandardLibraries>
    <NoStdLib>true</NoStdLib>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- Directory.Build.targets marks the src projects AOT-compatible so the trim and AOT
         analyzers check the host tooling. CoreLib is the platform assembly the NetWasm
         compiler compiles whole-program; it declares the reflection surface those
         analyzers annotate (as PlatformNotSupportedException members) and never meets
         ILLink or Native AOT, so the analyzers do not apply to it. -->
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <ProduceReferenceAssemblyInOutDir>true</ProduceReferenceAssemblyInOutDir>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- As upstream builds CoreLib, so its sources port verbatim. -->
    <LangVersion>preview</LangVersion>
    <!-- The reference contract follows System.Private.CoreLib's assembly-level
         CLS declaration. CLS diagnostics are consumer-facing; focused consumer
         tests retain genuine violations without failing this platform
         assembly's own build. -->
    <NoWarn>$(NoWarn);CS3001;CS3002;CS3003;CS3008;CS3015</NoWarn>
    <!-- As upstream CoreLib: generic vector code takes pointers to T. -->
    <NoWarn>$(NoWarn);CS8500</NoWarn>
    <!-- As upstream CoreLib: fields the runtime assigns (here, the compiler's runtime type facts) or tests
         swap, which C# reports as never assigned now that no library is granted CoreLib's internals. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <!-- Upstream shared sources choose CoreLib's public surface with this symbol. NETWASM is the symbol the SDK
         defines for netwasm projects; CoreLib's NetWasm adaptations of upstream sources use it. -->
    <DefineConstants>$(DefineConstants);SYSTEM_PRIVATE_CORELIB;NETWASM</DefineConstants>
    <!-- CoreLib implements System.Net.Sockets, so its shared sources take that assembly's public surface
         (ProtocolFamily is public there and internal elsewhere). -->
    <DefineConstants>$(DefineConstants);SYSTEM_NET_SOCKETS_DLL</DefineConstants>
  </PropertyGroup>

