    <PrunePackageReference Include="NetWasm.System.Text.RegularExpressions" Version="$(NetWasmSdkPackageVersion)" />
    <PrunePackageReference Include="NetWasm.System.Xml" Version="$(NetWasmSdkPackageVersion)" />
