<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Packages NetWasm.App provides, pruned from a netwasm0.1 restore as the .NET SDK prunes the packages
       Microsoft.NETCore.App provides: a dependency on one of them, at or below the version, takes the
       framework assembly instead of a second copy. The Microsoft packages and their versions are those
       Microsoft.NETCore.App.Ref 11.0.0 lists (data/PackageOverrides.txt) for the assemblies NetWasm.App
       ships and for NetWasm.App.Ref's framework facades (System.Runtime, System.Buffers,
       System.Threading.Tasks.Extensions and the rest), which forward to them; the NetWasm.System.* packages are
       the retired in-box packages, every version. -->
  <PropertyGroup>
    <RestoreEnablePackagePruning Condition="'$(RestoreEnablePackagePruning)' == ''">true</RestoreEnablePackagePruning>
  </PropertyGroup>
  <ItemGroup>
<PrunePackageReference Include="Microsoft.Win32.Primitives" Version="4.3.0" />
    <PrunePackageReference Include="System.AppContext" Version="4.3.0" />
    <PrunePackageReference Include="System.Buffers" Version="5.0.0" />
    <PrunePackageReference Include="System.Collections" Version="4.3.0" />
    <PrunePackageReference Include="System.Collections.Concurrent" Version="4.3.0" />
    <PrunePackageReference Include="System.Collections.Immutable" Version="11.0.0" />
    <PrunePackageReference Include="System.Collections.NonGeneric" Version="4.3.0" />
    <PrunePackageReference Include="System.Collections.Specialized" Version="4.3.0" />
    <PrunePackageReference Include="System.ComponentModel" Version="4.3.0" />
    <PrunePackageReference Include="System.ComponentModel.EventBasedAsync" Version="4.3.0" />
    <PrunePackageReference Include="System.ComponentModel.Primitives" Version="4.3.0" />
    <PrunePackageReference Include="System.ComponentModel.TypeConverter" Version="4.3.0" />
    <PrunePackageReference Include="System.Console" Version="4.3.1" />
    <PrunePackageReference Include="System.Data.Common" Version="4.3.0" />
    <PrunePackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PrunePackageReference Include="System.Diagnostics.Contracts" Version="4.3.0" />
    <PrunePackageReference Include="System.Diagnostics.Debug" Version="4.3.0" />
    <PrunePackageReference Include="System.Diagnostics.DiagnosticSource" Version="11.0.0" />
    <PrunePackageReference Include="System.Diagnostics.FileVersionInfo" Version="4.3.0" />
    <PrunePackageReference Include="System.Diagnostics.Process" Version="4.3.0" />
    <PrunePackageReference Include="System.Diagnostics.StackTrace" Version="4.3.0" />
    <PrunePackageReference Include="System.Diagnostics.TextWriterTraceListener" Version="4.3.0" />
    <PrunePackageReference Include="System.Diagnostics.Tools" Version="4.3.0" />
    <PrunePackageReference Include="System.Diagnostics.TraceSource" Version="4.3.0" />
    <PrunePackageReference Include="System.Diagnostics.Tracing" Version="4.3.0" />
    <PrunePackageReference Include="System.Drawing.Primitives" Version="4.3.0" />
    <PrunePackageReference Include="System.Dynamic.Runtime" Version="4.3.0" />
    <PrunePackageReference Include="System.Formats.Asn1" Version="11.0.0" />
    <PrunePackageReference Include="System.Globalization" Version="4.3.0" />
    <PrunePackageReference Include="System.Globalization.Calendars" Version="4.3.0" />
    <PrunePackageReference Include="System.Globalization.Extensions" Version="4.3.0" />
    <PrunePackageReference Include="System.IO" Version="4.3.0" />
    <PrunePackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PrunePackageReference Include="System.IO.Compression.ZipFile" Version="4.3.0" />
    <PrunePackageReference Include="System.IO.FileSystem" Version="4.3.0" />
    <PrunePackageReference Include="System.IO.FileSystem.DriveInfo" Version="4.3.1" />
    <PrunePackageReference Include="System.IO.FileSystem.Primitives" Version="4.3.0" />
    <PrunePackageReference Include="System.IO.FileSystem.Watcher" Version="4.3.0" />
    <PrunePackageReference Include="System.IO.IsolatedStorage" Version="4.3.0" />
    <PrunePackageReference Include="System.IO.MemoryMappedFiles" Version="4.3.0" />
    <PrunePackageReference Include="System.IO.Pipelines" Version="11.0.0" />
    <PrunePackageReference Include="System.IO.Pipes" Version="4.3.0" />
    <PrunePackageReference Include="System.IO.UnmanagedMemoryStream" Version="4.3.0" />
    <PrunePackageReference Include="System.Linq" Version="4.3.0" />
    <PrunePackageReference Include="System.Linq.AsyncEnumerable" Version="11.0.0" />
    <PrunePackageReference Include="System.Linq.Expressions" Version="4.3.0" />
    <PrunePackageReference Include="System.Linq.Parallel" Version="4.3.0" />
    <PrunePackageReference Include="System.Linq.Queryable" Version="4.3.0" />
    <PrunePackageReference Include="System.Memory" Version="5.0.0" />
    <PrunePackageReference Include="System.Net.Http" Version="4.3.4" />
    <PrunePackageReference Include="System.Net.Http.Json" Version="11.0.0" />
    <PrunePackageReference Include="System.Net.NameResolution" Version="4.3.0" />
    <PrunePackageReference Include="System.Net.NetworkInformation" Version="4.3.0" />
    <PrunePackageReference Include="System.Net.Ping" Version="4.3.0" />
    <PrunePackageReference Include="System.Net.Primitives" Version="4.3.1" />
    <PrunePackageReference Include="System.Net.Requests" Version="4.3.0" />
    <PrunePackageReference Include="System.Net.Security" Version="4.3.2" />
    <PrunePackageReference Include="System.Net.Sockets" Version="4.3.0" />
    <PrunePackageReference Include="System.Net.WebHeaderCollection" Version="4.3.0" />
    <PrunePackageReference Include="System.Net.WebSockets" Version="4.3.0" />
    <PrunePackageReference Include="System.Net.WebSockets.Client" Version="4.3.2" />
    <PrunePackageReference Include="System.Numerics.Vectors" Version="5.0.0" />
    <PrunePackageReference Include="System.ObjectModel" Version="4.3.0" />
    <PrunePackageReference Include="System.Reflection" Version="4.3.0" />
    <PrunePackageReference Include="System.Reflection.DispatchProxy" Version="6.0.0" />
    <PrunePackageReference Include="System.Reflection.Emit" Version="4.7.0" />
    <PrunePackageReference Include="System.Reflection.Emit.ILGeneration" Version="4.7.0" />
    <PrunePackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
    <PrunePackageReference Include="System.Reflection.Extensions" Version="4.3.0" />
    <PrunePackageReference Include="System.Reflection.Primitives" Version="4.3.0" />
    <PrunePackageReference Include="System.Resources.Reader" Version="4.3.0" />
    <PrunePackageReference Include="System.Resources.ResourceManager" Version="4.3.0" />
    <PrunePackageReference Include="System.Resources.Writer" Version="4.3.0" />
    <PrunePackageReference Include="System.Runtime" Version="4.3.1" />
    <PrunePackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="7.0.0" />
    <PrunePackageReference Include="System.Runtime.CompilerServices.VisualC" Version="4.3.0" />
    <PrunePackageReference Include="System.Runtime.Extensions" Version="4.3.1" />
    <PrunePackageReference Include="System.Runtime.Handles" Version="4.3.0" />
    <PrunePackageReference Include="System.Runtime.InteropServices" Version="4.3.0" />
    <PrunePackageReference Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
    <PrunePackageReference Include="System.Runtime.Numerics" Version="4.3.0" />
    <PrunePackageReference Include="System.Runtime.Serialization.Formatters" Version="4.3.0" />
    <PrunePackageReference Include="System.Runtime.Serialization.Json" Version="4.3.0" />
    <PrunePackageReference Include="System.Runtime.Serialization.Primitives" Version="4.3.0" />
    <PrunePackageReference Include="System.Runtime.Serialization.Xml" Version="4.3.0" />
    <PrunePackageReference Include="System.Security.Claims" Version="4.3.0" />
    <PrunePackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />
    <PrunePackageReference Include="System.Security.Cryptography.Csp" Version="4.3.0" />
    <PrunePackageReference Include="System.Security.Cryptography.Encoding" Version="4.3.0" />
    <PrunePackageReference Include="System.Security.Cryptography.OpenSsl" Version="5.0.0" />
    <PrunePackageReference Include="System.Security.Cryptography.Primitives" Version="4.3.0" />
    <PrunePackageReference Include="System.Security.Cryptography.X509Certificates" Version="4.3.2" />
    <PrunePackageReference Include="System.Security.Principal" Version="4.3.0" />
    <PrunePackageReference Include="System.Security.SecureString" Version="4.3.0" />
    <PrunePackageReference Include="System.Text.Encoding" Version="4.3.0" />
    <PrunePackageReference Include="System.Text.Encoding.Extensions" Version="4.3.0" />
    <PrunePackageReference Include="System.Text.Encodings.Web" Version="11.0.0" />
    <PrunePackageReference Include="System.Text.Json" Version="11.0.0" />
    <PrunePackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PrunePackageReference Include="System.Threading" Version="4.3.0" />
    <PrunePackageReference Include="System.Threading.Channels" Version="11.0.0" />
    <PrunePackageReference Include="System.Threading.Overlapped" Version="4.3.0" />
    <PrunePackageReference Include="System.Threading.Tasks" Version="4.3.0" />
    <PrunePackageReference Include="System.Threading.Tasks.Extensions" Version="5.0.0" />
    <PrunePackageReference Include="System.Threading.Tasks.Parallel" Version="4.3.0" />
    <PrunePackageReference Include="System.Threading.Thread" Version="4.3.0" />
    <PrunePackageReference Include="System.Threading.ThreadPool" Version="4.3.0" />
    <PrunePackageReference Include="System.Threading.Timer" Version="4.3.0" />
    <PrunePackageReference Include="System.ValueTuple" Version="4.6.1" />
    <PrunePackageReference Include="System.Xml.ReaderWriter" Version="4.3.1" />
    <PrunePackageReference Include="System.Xml.XDocument" Version="4.3.0" />
    <PrunePackageReference Include="System.Xml.XPath" Version="4.3.0" />
    <PrunePackageReference Include="System.Xml.XPath.XDocument" Version="5.0.0" />
    <PrunePackageReference Include="System.Xml.XmlDocument" Version="4.3.0" />
    <PrunePackageReference Include="System.Xml.XmlSerializer" Version="4.3.0" />
    <PrunePackageReference Include="NetWasm.System.Data.Common" Version="$(NetWasmSdkPackageVersion)" />
    <PrunePackageReference Include="NetWasm.System.IO.Pipelines" Version="$(NetWasmSdkPackageVersion)" />
    <PrunePackageReference Include="NetWasm.System.Linq" Version="$(NetWasmSdkPackageVersion)" />
    <PrunePackageReference Include="NetWasm.System.Linq.AsyncEnumerable" Version="$(NetWasmSdkPackageVersion)" />
    <PrunePackageReference Include="NetWasm.System.Memory" Version="$(NetWasmSdkPackageVersion)" />
    <PrunePackageReference Include="NetWasm.System.Net.Http" Version="$(NetWasmSdkPackageVersion)" />
    <PrunePackageReference Include="NetWasm.System.Net.Http.Json" Version="$(NetWasmSdkPackageVersion)" />
    <PrunePackageReference Include="NetWasm.System.Net.Requests" Version="$(NetWasmSdkPackageVersion)" />
