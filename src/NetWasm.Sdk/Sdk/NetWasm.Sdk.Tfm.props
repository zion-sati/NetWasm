<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Keep the declared alias as an opaque project value.  The canonical values
    below are the values consumed by NuGet/MSBuild after inference; no
    NuGetFramework formatter is used to recreate package identity.
  -->
  <PropertyGroup>
    <!--
      An inner build inherits TargetFrameworks from the outer build.  Use the
      current TargetFramework whenever it is present; otherwise the outer
      evaluation owns the full declared list.  This keeps desktop inner
      builds on stock pack targets in a dual-target project.
    -->
    <NetWasmSdkDeclaredTargetFrameworks Condition="'$(TargetFramework)' == ''">$(TargetFrameworks)</NetWasmSdkDeclaredTargetFrameworks>
    <NetWasmSdkDeclaredTargetFrameworks Condition="'$(TargetFramework)' != ''">$(TargetFramework)</NetWasmSdkDeclaredTargetFrameworks>
    <NetWasmSdkContainsCustomProfile Condition="'$(NetWasmSdkDeclaredTargetFrameworks)' != ''">$([System.String]::Copy(';$(NetWasmSdkDeclaredTargetFrameworks);').Contains(';netwasm0.1;'))</NetWasmSdkContainsCustomProfile>
    <NetWasmRefPackageId Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true' AND '$(NetWasmRefPackageId)' == ''">NetWasm.Ref</NetWasmRefPackageId>
    <NetWasmRefPackageVersion Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true' AND '$(NetWasmRefPackageVersion)' == ''">0.4.2</NetWasmRefPackageVersion>
    <NetWasmRuntimePackageVersion Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true' AND '$(NetWasmRuntimePackageVersion)' == ''">0.4.2</NetWasmRuntimePackageVersion>
    <NetWasmRuntimePackPackageVersion Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true' AND '$(NetWasmRuntimePackPackageVersion)' == ''">0.4.2</NetWasmRuntimePackPackageVersion>
    <NetWasmToolchainPackageVersion Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true' AND '$(NetWasmToolchainPackageVersion)' == ''">0.4.2</NetWasmToolchainPackageVersion>
    <NetWasmHostingPackageVersion Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true' AND '$(NetWasmHostingPackageVersion)' == ''">0.4.2</NetWasmHostingPackageVersion>
    <NetWasmHostingBuildPackageVersion Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true' AND '$(NetWasmHostingBuildPackageVersion)' == ''">0.4.2</NetWasmHostingBuildPackageVersion>
    <NetWasmHostToolsPackageVersion Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true' AND '$(NetWasmHostToolsPackageVersion)' == ''">0.4.2</NetWasmHostToolsPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <NetWasmSdkProfile Include="netwasm0.1"
                       Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true'">
      <Alias>netwasm0.1</Alias>
      <Identifier>NetWasm</Identifier>
      <Version>v0.1</Version>
      <CanonicalFolder>NetWasm,Version=v0.1</CanonicalFolder>
      <CanonicalDependencyGroup>NetWasm,Version=v0.1</CanonicalDependencyGroup>
    </NetWasmSdkProfile>
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netwasm0.1'">
    <TargetFrameworkIdentifier>NetWasm</TargetFrameworkIdentifier>
    <TargetExt>.dll</TargetExt>
    <TargetFrameworkVersion>v0.1</TargetFrameworkVersion>
    <TargetFrameworkMoniker>NetWasm,Version=v0.1</TargetFrameworkMoniker>
    <NuGetTargetMoniker>NetWasm,Version=v0.1</NuGetTargetMoniker>
    <DefineConstants>$(DefineConstants);NETWASM;NETWASM0_1</DefineConstants>
    <LangVersion Condition="'$(LangVersion)' == ''">latest</LangVersion>
    <NetWasmSdkTargetFrameworkAlias>netwasm0.1</NetWasmSdkTargetFrameworkAlias>
    <NetWasmSdkCanonicalTargetFramework>NetWasm,Version=v0.1</NetWasmSdkCanonicalTargetFramework>
    <!-- There is no installed desktop targeting pack for the custom profile.
         The stock SDK's standard-framework resolver must be disabled; the
         ordinary ResolvePackageAssets target supplies every compile reference
         from the restored NetWasm.Ref contract. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <DisableStandardFrameworkResolution>true</DisableStandardFrameworkResolution>
    <NoStandardLibraries>true</NoStandardLibraries>
    <NoStdLib>true</NoStdLib>
    <!-- The managed assembly and symbols are compiler inputs, not deployable
         NetWasm executable artifacts. Publish stages only the selected,
         manifest-bound deployment closure. -->
    <CopyBuildOutputToPublishDirectory>false</CopyBuildOutputToPublishDirectory>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <NetWasmTarget Condition="'$(NetWasmTarget)' == ''">wasm32</NetWasmTarget>
    <!-- A test root must declare IsTestProject during its first restore. -->
    <NetWasmRequiresHostTools Condition="'$(NetWasmRequiresHostTools)' == ''">false</NetWasmRequiresHostTools>
    <NetWasmRequiresHostTools Condition="'$(OutputType)' == 'Exe' OR '$(IsTestProject)' == 'true'">true</NetWasmRequiresHostTools>
    <NetWasmBuildHostOSArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</NetWasmBuildHostOSArchitecture>
    <NetWasmHostToolsPackageId Condition="'$(NetWasmRequiresHostTools)' == 'true' AND ('$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64' OR '$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64' OR '$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64' OR '$(NETCoreSdkRuntimeIdentifier)' == 'win-x64' OR '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64')">NetWasm.HostTools.$(NETCoreSdkRuntimeIdentifier)</NetWasmHostToolsPackageId>
    <NetWasmUsesHostQualifiedLockFile Condition="'$(NetWasmRequiresHostTools)' == 'true' AND '$(RestorePackagesWithLockFile)' == 'true' AND '$(NuGetLockFilePath)' == '' AND '$(NetWasmHostToolsPackageId)' != ''">true</NetWasmUsesHostQualifiedLockFile>
    <NuGetLockFilePath Condition="'$(NetWasmUsesHostQualifiedLockFile)' == 'true'">packages.$(NETCoreSdkRuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true'">
    <NetWasmSdkCustomProfileEnabled>true</NetWasmSdkCustomProfileEnabled>
    <NetWasmSdkCustomProfileAlias>netwasm0.1</NetWasmSdkCustomProfileAlias>
    <NetWasmSdkCustomProfileCanonicalTargetFramework>NetWasm,Version=v0.1</NetWasmSdkCustomProfileCanonicalTargetFramework>
    <!--
      The reference contract is a private, target-specific build edge.  It is
      deliberately injected through ordinary PackageReference evaluation so
      stock restore remains the source of truth; desktop inner builds never
      see this item.
    -->
    <NetWasmRefPackageVersion Condition="'$(NetWasmRefPackageVersion)' == ''">0.4.2</NetWasmRefPackageVersion>
    <NetWasmToolchainPackageVersion Condition="'$(NetWasmToolchainPackageVersion)' == ''">0.4.2</NetWasmToolchainPackageVersion>
    <NetWasmHostingPackageVersion Condition="'$(NetWasmHostingPackageVersion)' == ''">0.4.2</NetWasmHostingPackageVersion>
    <NetWasmHostingBuildPackageVersion Condition="'$(NetWasmHostingBuildPackageVersion)' == ''">0.4.2</NetWasmHostingBuildPackageVersion>
    <BuildProjectReferences Condition="'$(NoBuild)' == 'true'">false</BuildProjectReferences>
    <NuGetBuildTasksPackTargets>$(MSBuildThisFileDirectory)NuGetBuildTasksPackTargets.targets</NuGetBuildTasksPackTargets>
    <ImportNuGetBuildTasksPackTargetsFromSdk>true</ImportNuGetBuildTasksPackTargetsFromSdk>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)NetWasm.PackageVersions.props"
          Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true' AND ('$(NetWasmCompilerTasksPackageVersion)' == '' OR '$(NetWasmHostToolsPackageVersion)' == '')" />

  <ItemGroup Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)NetWasm.Sdk.Analyzers.globalconfig" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netwasm0.1' AND '$(NetWasmRefPackageId)' != ''">
    <PackageReference Include="$(NetWasmRefPackageId)"
                      PrivateAssets="all"
                      IncludeAssets="compile">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmRefPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmRefPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Compiler.Tasks"
                      PrivateAssets="all">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmCompilerTasksPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmCompilerTasksPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Runtime.Wasm32"
                      PrivateAssets="all"
                      Condition="'$(NetWasmTarget)' == 'wasm32'">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmRuntimePackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmRuntimePackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Runtime.Wasm64"
                      PrivateAssets="all"
                      Condition="'$(NetWasmTarget)' == 'wasm64'">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmRuntimePackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmRuntimePackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Runtime.Pack"
                      PrivateAssets="all">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmRuntimePackPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmRuntimePackPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Toolchain"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="compile;runtime;analyzers">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmToolchainPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmToolchainPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Hosting"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="compile;runtime;analyzers">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmHostingPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmHostingPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Hosting.Build"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="compile;runtime;analyzers">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmHostingBuildPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmHostingBuildPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="$(NetWasmHostToolsPackageId)"
                      Version="[$(NetWasmHostToolsPackageVersion)]"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="all"
                      Condition="'$(NetWasmRequiresHostTools)' == 'true' AND '$(NetWasmHostToolsPackageId)' != '' AND '$(ManagePackageVersionsCentrally)' != 'true'" />
    <PackageReference Include="$(NetWasmHostToolsPackageId)"
                      VersionOverride="[$(NetWasmHostToolsPackageVersion)]"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="all"
                      Condition="'$(NetWasmRequiresHostTools)' == 'true' AND '$(NetWasmHostToolsPackageId)' != '' AND '$(ManagePackageVersionsCentrally)' == 'true'" />
  </ItemGroup>
</Project>
