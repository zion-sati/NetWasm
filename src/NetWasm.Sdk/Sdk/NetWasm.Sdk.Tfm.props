<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- NetWasm.Sdk defines NetWasmGuestFramework; a project that imports this file without it, or before it, gets
       the same answer: a .NET platform target framework on netwasm, or netwasm0.1. -->
  <PropertyGroup Condition="'$(NetWasmGuestFramework)' == ''">
    <NetWasmGuestFramework Condition="'$(TargetFramework)' == 'netwasm0.1' OR $(TargetFramework.ToLowerInvariant().Contains('-netwasm'))">true</NetWasmGuestFramework>
  </PropertyGroup>
  <!--
    Keep the declared alias as an opaque project value.  The canonical values
    below are the values consumed by NuGet/MSBuild after inference; no
    NuGetFramework formatter is used to recreate package identity.
  -->
  <PropertyGroup>
    <!--
      An inner build inherits TargetFrameworks from the outer build.  Use the
      current TargetFramework whenever it is present; otherwise the outer
      evaluation owns the full declared list.  This keeps desktop inner
      builds on stock pack targets in a dual-target project.
    -->
    <NetWasmSdkDeclaredTargetFrameworks Condition="'$(TargetFramework)' == ''">$(TargetFrameworks)</NetWasmSdkDeclaredTargetFrameworks>
    <NetWasmSdkDeclaredTargetFrameworks Condition="'$(TargetFramework)' != ''">$(TargetFramework)</NetWasmSdkDeclaredTargetFrameworks>
    <NetWasmSdkContainsCustomProfile Condition="'$(NetWasmSdkDeclaredTargetFrameworks)' != ''">$([System.String]::Copy(';$(NetWasmSdkDeclaredTargetFrameworks);').Contains(';netwasm0.1;'))</NetWasmSdkContainsCustomProfile>
    <!-- A platform target framework such as net10.0-netwasm: .NET's own framework on the netwasm platform. -->
    <NetWasmSdkContainsPlatformFramework Condition="'$(NetWasmSdkDeclaredTargetFrameworks)' != ''">$([System.String]::Copy('$(NetWasmSdkDeclaredTargetFrameworks)').ToLowerInvariant().Contains('-netwasm'))</NetWasmSdkContainsPlatformFramework>
    <NetWasmSdkContainsGuestFramework Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true' OR '$(NetWasmSdkContainsPlatformFramework)' == 'true'">true</NetWasmSdkContainsGuestFramework>
    <NetWasmRefPackageId Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND '$(NetWasmRefPackageId)' == ''">NetWasm.Ref</NetWasmRefPackageId>
    <NetWasmRefPackageVersion Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND '$(NetWasmRefPackageVersion)' == ''">0.4.2</NetWasmRefPackageVersion>
    <NetWasmRuntimePackageVersion Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND '$(NetWasmRuntimePackageVersion)' == ''">0.4.2</NetWasmRuntimePackageVersion>
    <NetWasmRuntimePackPackageVersion Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND '$(NetWasmRuntimePackPackageVersion)' == ''">0.4.2</NetWasmRuntimePackPackageVersion>
    <NetWasmAppRefPackageVersion Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND '$(NetWasmAppRefPackageVersion)' == ''">0.4.2</NetWasmAppRefPackageVersion>
    <NetWasmAppRuntimePackageVersion Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND '$(NetWasmAppRuntimePackageVersion)' == ''">0.4.2</NetWasmAppRuntimePackageVersion>
    <NetWasmToolchainPackageVersion Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND '$(NetWasmToolchainPackageVersion)' == ''">0.4.2</NetWasmToolchainPackageVersion>
    <NetWasmHostingPackageVersion Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND '$(NetWasmHostingPackageVersion)' == ''">0.4.2</NetWasmHostingPackageVersion>
    <NetWasmHostingBuildPackageVersion Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND '$(NetWasmHostingBuildPackageVersion)' == ''">0.4.2</NetWasmHostingBuildPackageVersion>
    <NetWasmHostToolsPackageVersion Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND '$(NetWasmHostToolsPackageVersion)' == ''">0.4.2</NetWasmHostToolsPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <NetWasmSdkProfile Include="netwasm0.1"
                       Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true'">
      <Alias>netwasm0.1</Alias>
      <Identifier>NetWasm</Identifier>
      <Version>v0.1</Version>
      <CanonicalFolder>NetWasm,Version=v0.1</CanonicalFolder>
      <CanonicalDependencyGroup>NetWasm,Version=v0.1</CanonicalDependencyGroup>
    </NetWasmSdkProfile>
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netwasm0.1'">
    <TargetFrameworkIdentifier>NetWasm</TargetFrameworkIdentifier>
    <TargetExt>.dll</TargetExt>
    <TargetFrameworkVersion>v0.1</TargetFrameworkVersion>
    <TargetFrameworkMoniker>NetWasm,Version=v0.1</TargetFrameworkMoniker>
    <NuGetTargetMoniker>NetWasm,Version=v0.1</NuGetTargetMoniker>
    <!-- NuGet owns nearest compatible .NET Standard asset selection. The
         application retains its NetWasm identity and exact assets win. -->
    <AssetTargetFallback Condition="'$(AssetTargetFallback)' == ''">netstandard2.1</AssetTargetFallback>
    <DefineConstants>$(DefineConstants);NETWASM;NETWASM0_1</DefineConstants>
    <LangVersion Condition="'$(LangVersion)' == ''">latest</LangVersion>
    <NetWasmSdkTargetFrameworkAlias>netwasm0.1</NetWasmSdkTargetFrameworkAlias>
    <NetWasmSdkCanonicalTargetFramework>NetWasm,Version=v0.1</NetWasmSdkCanonicalTargetFramework>
  </PropertyGroup>

  <!-- The platform target framework: .NET's own framework, so NuGet takes a package's net10.0, net9.0, net8.0 or
       netstandard build natively. The SDK declares the netwasm platform as a workload declares its own; NuGet
       requires a platform version, 1.0 unless the target framework names one. -->
  <PropertyGroup Condition="'$(_NetWasmPlatformFramework)' == 'true'">
    <TargetPlatformSupported>true</TargetPlatformSupported>
    <TargetPlatformVersion Condition="'$(TargetPlatformVersion)' == '' AND $(TargetFramework.ToLowerInvariant().EndsWith('-netwasm'))">1.0</TargetPlatformVersion>
    <DefineConstants>$(DefineConstants);NETWASM</DefineConstants>
    <!-- A NetWasm executable is a WebAssembly module, not a desktop host: no apphost, and none of the .NET host's
         files (runtimeconfig.json, deps.json), which no NetWasm host reads and a netwasm0.1 build never wrote. -->
    <UseAppHost>false</UseAppHost>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- A .NETCoreApp build without a runtime identifier copies every platform's native assets from runtimes/;
         a WebAssembly guest can use none of them, as a netwasm0.1 build never received them. -->
    <CopyLocalRuntimeTargetAssets>false</CopyLocalRuntimeTargetAssets>
  </PropertyGroup>
  <ItemGroup Condition="'$(_NetWasmPlatformFramework)' == 'true'">
    <SdkSupportedTargetPlatformIdentifier Include="netwasm" DisplayName="NetWasm" />
    <SdkSupportedTargetPlatformVersion Include="1.0" />
    <SupportedPlatform Include="netwasm" />
  </ItemGroup>

  <PropertyGroup Condition="'$(NetWasmGuestFramework)' == 'true'">
    <!-- Every guest build compiles against NetWasm's surface (NetWasm.Ref and NetWasm.App.Ref), not a desktop
         targeting pack: the stock framework resolver stays off, and ResolvePackageAssets supplies the
         references. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <DisableStandardFrameworkResolution>true</DisableStandardFrameworkResolution>
    <NoStandardLibraries>true</NoStandardLibraries>
    <NoStdLib>true</NoStdLib>
    <!-- The managed assembly and symbols are compiler inputs, not deployable
         NetWasm executable artifacts. Publish stages only the selected,
         manifest-bound deployment closure. -->
    <CopyBuildOutputToPublishDirectory>false</CopyBuildOutputToPublishDirectory>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <NetWasmTarget Condition="'$(NetWasmTarget)' == ''">wasm32</NetWasmTarget>
    <!-- The 10.0.1xx SDK's NuGet keys the netwasm0.1 restore target by framework
         name, which that SDK's build cannot find (NETSDK1005); net10.0-netwasm is
         not qualified on it either. The templates pin the same version in global.json. -->
    <_NetWasmMinimumSdkVersion>10.0.303</_NetWasmMinimumSdkVersion>
    <!-- A test root must declare IsTestProject during its first restore. -->
    <NetWasmRequiresHostTools Condition="'$(NetWasmRequiresHostTools)' == ''">false</NetWasmRequiresHostTools>
    <NetWasmRequiresHostTools Condition="'$(OutputType)' == 'Exe' OR '$(IsTestProject)' == 'true' OR '$(_NetWasmWorkerKind)' != '' OR '$(_NetWasmPlainCoreModule)' == 'true' OR '$(_NetWasmComponentLibrary)' == 'true'">true</NetWasmRequiresHostTools>
    <NetWasmBuildHostOSArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</NetWasmBuildHostOSArchitecture>
    <!-- A distribution-built .NET SDK reports its distribution's RID (arch-x64,
         fedora.42-x64, rhel.9-x64); the host tools are built for the portable
         RID that every SDK also reports. -->
    <_NetWasmHostRid>$(NETCoreSdkPortableRuntimeIdentifier)</_NetWasmHostRid>
    <_NetWasmHostRid Condition="'$(_NetWasmHostRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_NetWasmHostRid>
    <!-- A NetWasmWit item also needs the host tools, to run wasm-tools on Node;
         its PackageReference condition below tests the items. -->
    <NetWasmHostToolsPackageId Condition="('$(_NetWasmHostRid)' == 'linux-x64' OR '$(_NetWasmHostRid)' == 'linux-arm64' OR '$(_NetWasmHostRid)' == 'osx-arm64' OR '$(_NetWasmHostRid)' == 'win-x64' OR '$(_NetWasmHostRid)' == 'win-arm64')">NetWasm.HostTools.$(_NetWasmHostRid)</NetWasmHostToolsPackageId>
    <NetWasmUsesHostQualifiedLockFile Condition="'$(NetWasmRequiresHostTools)' == 'true' AND '$(RestorePackagesWithLockFile)' == 'true' AND '$(NuGetLockFilePath)' == '' AND '$(NetWasmHostToolsPackageId)' != ''">true</NetWasmUsesHostQualifiedLockFile>
    <NuGetLockFilePath Condition="'$(NetWasmUsesHostQualifiedLockFile)' == 'true'">packages.$(_NetWasmHostRid).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NetWasmSdkContainsCustomProfile)' == 'true'">
    <NetWasmSdkCustomProfileEnabled>true</NetWasmSdkCustomProfileEnabled>
    <NetWasmSdkCustomProfileAlias>netwasm0.1</NetWasmSdkCustomProfileAlias>
    <NetWasmSdkCustomProfileCanonicalTargetFramework>NetWasm,Version=v0.1</NetWasmSdkCustomProfileCanonicalTargetFramework>
    <!--
      The reference contract is a private, target-specific build edge.  It is
      deliberately injected through ordinary PackageReference evaluation so
      stock restore remains the source of truth; desktop inner builds never
      see this item.
    -->
    <NetWasmRefPackageVersion Condition="'$(NetWasmRefPackageVersion)' == ''">0.4.2</NetWasmRefPackageVersion>
    <NetWasmToolchainPackageVersion Condition="'$(NetWasmToolchainPackageVersion)' == ''">0.4.2</NetWasmToolchainPackageVersion>
    <NetWasmHostingPackageVersion Condition="'$(NetWasmHostingPackageVersion)' == ''">0.4.2</NetWasmHostingPackageVersion>
    <NetWasmHostingBuildPackageVersion Condition="'$(NetWasmHostingBuildPackageVersion)' == ''">0.4.2</NetWasmHostingBuildPackageVersion>
    <BuildProjectReferences Condition="'$(NoBuild)' == 'true'">false</BuildProjectReferences>
    <NuGetBuildTasksPackTargets>$(MSBuildThisFileDirectory)NuGetBuildTasksPackTargets.targets</NuGetBuildTasksPackTargets>
    <ImportNuGetBuildTasksPackTargetsFromSdk>true</ImportNuGetBuildTasksPackTargetsFromSdk>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)NetWasm.PackageVersions.props"
          Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true' AND ('$(NetWasmCompilerTasksPackageVersion)' == '' OR '$(NetWasmHostToolsPackageVersion)' == '')" />

  <PropertyGroup Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true'">
    <NetWasmSdkPackTaskAssemblyFile Condition="'$(NetWasmSdkPackTaskAssemblyFile)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\any\NetWasm.Sdk.Pack.dll</NetWasmSdkPackTaskAssemblyFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(NetWasmSdkContainsGuestFramework)' == 'true'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)NetWasm.Sdk.Analyzers.globalconfig" />
  </ItemGroup>

  <ItemGroup Condition="'$(NetWasmGuestFramework)' == 'true'">
    <!-- Tool-only download: never add desktop generator assemblies to guest references. A
         component also gets it, since the bindings of the world it exports may come from a
         package's targets, which restore has not imported yet. -->
    <PackageDownload Include="NetWasm.Wit.Bindings.Tool" Version="[$(NetWasmSdkPackageVersion)]"
                     Condition="'@(_NetWasmWorkerReference)' != '' OR '@(NetWasmWit)' != '' OR '$(_NetWasmComponentLibrary)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(NetWasmGuestFramework)' == 'true' AND '$(NetWasmRefPackageId)' != ''">
    <PackageReference Include="$(NetWasmRefPackageId)"
                      PrivateAssets="all"
                      IncludeAssets="compile;analyzers">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmRefPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmRefPackageVersion)</VersionOverride>
    </PackageReference>
    <!-- NetWasm.App, the framework beyond CoreLib (System.Collections, System.Linq, System.Text.Json and
         the rest): its reference assemblies, netstandard.dll and source generators for C#, and its
         implementations for the NetWasm compiler. DisableImplicitNetWasmAppReference compiles against
         CoreLib alone. -->
    <PackageReference Include="NetWasm.App.Ref"
                      PrivateAssets="all"
                      IncludeAssets="compile;analyzers"
                      Condition="'$(DisableImplicitNetWasmAppReference)' != 'true'">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmAppRefPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmAppRefPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.App.Runtime"
                      PrivateAssets="all"
                      Condition="'$(DisableImplicitNetWasmAppReference)' != 'true'">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmAppRuntimePackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmAppRuntimePackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Compiler.Tasks"
                      PrivateAssets="all">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmCompilerTasksPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmCompilerTasksPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Runtime.Wasm32"
                      PrivateAssets="all"
                      Condition="'$(NetWasmTarget)' == 'wasm32'">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmRuntimePackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmRuntimePackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Runtime.Wasm64"
                      PrivateAssets="all"
                      Condition="'$(NetWasmTarget)' == 'wasm64'">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmRuntimePackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmRuntimePackageVersion)</VersionOverride>
    </PackageReference>
    <!-- Its lib/net10.0 is the SDK's selector assembly, which its build files load by path; a net10.0-netwasm
         build would otherwise take it as a reference. -->
    <PackageReference Include="NetWasm.Runtime.Pack"
                      PrivateAssets="all"
                      ExcludeAssets="compile;runtime">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmRuntimePackPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmRuntimePackPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Toolchain"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="compile;runtime;analyzers">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmToolchainPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmToolchainPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Hosting"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="compile;runtime;analyzers">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmHostingPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmHostingPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="NetWasm.Hosting.Build"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="compile;runtime;analyzers">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(NetWasmHostingBuildPackageVersion)</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(NetWasmHostingBuildPackageVersion)</VersionOverride>
    </PackageReference>
    <PackageReference Include="$(NetWasmHostToolsPackageId)"
                      Version="[$(NetWasmHostToolsPackageVersion)]"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="all"
                      Condition="('$(NetWasmRequiresHostTools)' == 'true' OR '@(NetWasmWit)' != '') AND '$(NetWasmHostToolsPackageId)' != '' AND '$(ManagePackageVersionsCentrally)' != 'true'" />
    <PackageReference Include="$(NetWasmHostToolsPackageId)"
                      VersionOverride="[$(NetWasmHostToolsPackageVersion)]"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      ExcludeAssets="all"
                      Condition="('$(NetWasmRequiresHostTools)' == 'true' OR '@(NetWasmWit)' != '') AND '$(NetWasmHostToolsPackageId)' != '' AND '$(ManagePackageVersionsCentrally)' == 'true'" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)NetWasm.App.PackagePruning.props"
          Condition="'$(NetWasmGuestFramework)' == 'true' AND '$(DisableImplicitNetWasmAppReference)' != 'true'" />
</Project>
