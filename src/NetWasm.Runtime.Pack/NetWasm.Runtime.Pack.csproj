<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NetWasm.Runtime.Pack</AssemblyName>
    <RootNamespace>NetWasm.Runtime.Pack</RootNamespace>
    <Version>0.4.2</Version>
    <PackageId>NetWasm.Runtime.Pack</PackageId>
    <Description>Relocatable NetWasm runtime archives materialized for each application.</Description>
    <PackageTags>netwasm;runtime;wasi;wasm</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NetWasmRuntimePackAssetRoot Condition="'$(NetWasmRuntimePackAssetRoot)' == ''">$(MSBuildThisFileDirectory)runtime</NetWasmRuntimePackAssetRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core"
                      Version="18.0.2"
                      PrivateAssets="all"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="README.md" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/LICENSE.txt"
          Pack="true"
          PackagePath="LICENSE.txt" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/wasm32/compact/libnetwasm-runtime.a;$(NetWasmRuntimePackAssetRoot)/wasm32/compact/libgc.a;$(NetWasmRuntimePackAssetRoot)/wasm32/compact/layout.json"
          Pack="true"
          PackagePath="runtime/wasm32/compact/" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/wasm32/boehm/libnetwasm-runtime.a;$(NetWasmRuntimePackAssetRoot)/wasm32/boehm/libgc.a;$(NetWasmRuntimePackAssetRoot)/wasm32/boehm/layout.json"
          Pack="true"
          PackagePath="runtime/wasm32/boehm/" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/wasm64/compact/libnetwasm-runtime.a;$(NetWasmRuntimePackAssetRoot)/wasm64/compact/libgc.a;$(NetWasmRuntimePackAssetRoot)/wasm64/compact/layout.json"
          Pack="true"
          PackagePath="runtime/wasm64/compact/" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/wasm64/boehm/libnetwasm-runtime.a;$(NetWasmRuntimePackAssetRoot)/wasm64/boehm/libgc.a;$(NetWasmRuntimePackAssetRoot)/wasm64/boehm/layout.json"
          Pack="true"
          PackagePath="runtime/wasm64/boehm/" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/wasm32/allowed-undefined-symbols.txt"
          Pack="true"
          PackagePath="runtime/wasm32/" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/wasm64/allowed-undefined-symbols.txt"
          Pack="true"
          PackagePath="runtime/wasm64/" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/wasm32/system-libraries/*.a"
          Pack="true"
          PackagePath="runtime/wasm32/system-libraries/" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/wasm64/system-libraries/*.a"
          Pack="true"
          PackagePath="runtime/wasm64/system-libraries/" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/runtime-pack.json"
          Pack="true"
          PackagePath="runtime/runtime-pack.json" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/runtime-policy.json"
          Pack="true"
          PackagePath="runtime/runtime-policy.json" />
    <None Include="$(NetWasmRuntimePackAssetRoot)/runtime-exports.txt"
          Pack="true"
          PackagePath="runtime/runtime-exports.txt" />
    <None Include="buildTransitive/NetWasm.Runtime.Pack.props"
          Pack="true"
          PackagePath="buildTransitive/" />
    <None Include="buildTransitive/NetWasm.Runtime.Pack.targets"
          Pack="true"
          PackagePath="buildTransitive/" />
  </ItemGroup>

  <Import Project="../../eng/NetWasm.DeterministicPackageArchive.targets" />
</Project>
