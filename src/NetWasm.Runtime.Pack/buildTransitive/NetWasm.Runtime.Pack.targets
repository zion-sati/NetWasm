<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- NetWasm.Sdk defines NetWasmGuestFramework; a project that imports this file without it, or before it, gets
       the same answer: a .NET platform target framework on netwasm, or netwasm0.1. -->
  <PropertyGroup Condition="'$(NetWasmGuestFramework)' == ''">
    <NetWasmGuestFramework Condition="'$(TargetFramework)' == 'netwasm0.1' OR $(TargetFramework.ToLowerInvariant().Contains('-netwasm'))">true</NetWasmGuestFramework>
  </PropertyGroup>
  <!-- MSBuild on .NET runs the runtime pack's tasks in its own process. MSBuild on .NET Framework, as Visual
       Studio's is, runs these .NET tasks in a .NET task host, as does a build that sets
       NetWasmIsolateBuildTasks=true: a process of their own for each task. -->
  <PropertyGroup>
    <_NetWasmBuildTaskFactory Condition="'$(MSBuildRuntimeType)' != 'Core' OR '$(NetWasmIsolateBuildTasks)' == 'true'">TaskHostFactory</_NetWasmBuildTaskFactory>
    <!-- NetWasm.Sdk decides whether a project builds a module (it adds plain core modules); a
         project importing these targets alone builds one as an executable or a worker. -->
    <_NetWasmBuildsModule Condition="'$(_NetWasmBuildsModule)' == '' AND ('$(OutputType)' == 'Exe' OR '$(_NetWasmWorkerKind)' != '')">true</_NetWasmBuildsModule>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NetWasmGuestFramework)' == 'true'">
    <_NetWasmCanonicalOptimization Condition="'$(_NetWasmCanonicalOptimization)' == ''">$(NetWasmOptimization)</_NetWasmCanonicalOptimization>
    <NetWasmRuntimePackRoot Condition="'$(NetWasmRuntimePackRoot)' == ''">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '..', 'runtime'))</NetWasmRuntimePackRoot>
    <NetWasmRuntimePackManifestPath Condition="'$(NetWasmRuntimePackManifestPath)' == ''">$([System.IO.Path]::Combine('$(NetWasmRuntimePackRoot)', 'runtime-pack.json'))</NetWasmRuntimePackManifestPath>
    <NetWasmRuntimePackSelectorAssemblyPath Condition="'$(NetWasmRuntimePackSelectorAssemblyPath)' == ''">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '..', 'lib', 'net10.0', 'NetWasm.Runtime.Pack.dll'))</NetWasmRuntimePackSelectorAssemblyPath>
    <NetWasmRuntimePackProvided>true</NetWasmRuntimePackProvided>
  </PropertyGroup>

  <UsingTask TaskName="NetWasm.Runtime.Pack.MsBuild.PackageNativeArchiveSelectionTask"
             Runtime="NET"
             Architecture="CurrentArchitecture"
             TaskFactory="$(_NetWasmBuildTaskFactory)"
             AssemblyFile="$(NetWasmRuntimePackSelectorAssemblyPath)"
             Condition="'$(NetWasmGuestFramework)' == 'true'" />

  <!-- A package that ships its static archives per Emscripten version, as SkiaSharp and HarfBuzzSharp do for .NET's
       WebAssembly SDKs, gives an executable its matching build: the newest no newer than this runtime pack's
       Emscripten, single-threaded, with SIMD where there is one. A library the project names itself keeps the
       project's archive. NetWasm links an archive only where a native import reaches it. -->
  <Target Name="NetWasmSelectPackageNativeArchives"
          BeforeTargets="NetWasmCollectNativeLibraries"
          DependsOnTargets="ResolvePackageAssets"
          Condition="'$(NetWasmGuestFramework)' == 'true' AND '$(_NetWasmBuildsModule)' == 'true' AND '$(NetWasmTarget)' == 'wasm32' AND Exists('$(ProjectAssetsFile)') AND Exists('$(NetWasmRuntimePackManifestPath)')">
    <PackageNativeArchiveSelectionTask ProjectAssetsFile="$(ProjectAssetsFile)"
                                       RuntimePackManifestPath="$(NetWasmRuntimePackManifestPath)"
                                       WasmTarget="$(NetWasmTarget)"
                                       ExistingNativeLibraries="@(NativeLibrary)">
      <Output TaskParameter="NativeLibraries" ItemName="NativeLibrary" />
    </PackageNativeArchiveSelectionTask>
  </Target>

  <UsingTask TaskName="NetWasm.Runtime.Pack.MsBuild.RuntimeMaterializationTask"
             Runtime="NET"
             Architecture="CurrentArchitecture"
             TaskFactory="$(_NetWasmBuildTaskFactory)"
             AssemblyFile="$(NetWasmRuntimePackSelectorAssemblyPath)"
             Condition="'$(NetWasmGuestFramework)' == 'true'" />

  <ItemGroup Condition="'$(NetWasmGuestFramework)' == 'true'">
    <NetWasmRuntimePackAsset Include="$(NetWasmRuntimePackManifestPath)"
                             Condition="Exists('$(NetWasmRuntimePackManifestPath)')">
      <Kind>RuntimePackManifest</Kind>
      <MediaType>application/json</MediaType>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </NetWasmRuntimePackAsset>
    <_NetWasmRuntimePackMaterializationInput Include="$(NetWasmRuntimePackRoot)/**/*" />
  </ItemGroup>

  <Target Name="NetWasmRuntimePackResolveOutputPaths"
          Condition="'$(NetWasmGuestFramework)' == 'true'">
    <Error Code="NWPACK005"
           Condition="'$(NetWasmIntermediateOutputPath)' == '' AND ('$(NetWasmRuntimePackMaterializedPath)' == '' OR '$(NetWasmRuntimePackLogDirectory)' == '' OR '$(NetWasmRuntimePackCacheDirectory)' == '')"
           Text="The NetWasm intermediate output directory is unavailable for runtime-pack artifacts." />
    <PropertyGroup>
      <NetWasmRuntimePackMaterializedPath Condition="'$(NetWasmRuntimePackMaterializedPath)' == ''">$([System.IO.Path]::Combine('$(NetWasmIntermediateOutputPath)', 'runtime.$(NetWasmTarget).wasm'))</NetWasmRuntimePackMaterializedPath>
      <NetWasmRuntimePackLogDirectory Condition="'$(NetWasmRuntimePackLogDirectory)' == ''">$([System.IO.Path]::Combine('$(NetWasmIntermediateOutputPath)', 'runtime-logs'))</NetWasmRuntimePackLogDirectory>
      <NetWasmRuntimePackCacheDirectory Condition="'$(NetWasmRuntimePackCacheDirectory)' == ''">$([System.IO.Path]::Combine('$(NetWasmIntermediateOutputPath)', 'runtime-cache'))</NetWasmRuntimePackCacheDirectory>
      <NetWasmRuntimePackMaterializationIdentityPath Condition="'$(NetWasmRuntimePackMaterializationIdentityPath)' == ''">$([System.IO.Path]::Combine('$(NetWasmIntermediateOutputPath)', 'runtime-materialization.identity'))</NetWasmRuntimePackMaterializationIdentityPath>
    </PropertyGroup>
  </Target>

  <Target Name="NetWasmRuntimePackWriteMaterializationIdentity"
          DependsOnTargets="NetWasmRuntimePackResolveOutputPaths"
          Condition="'$(NetWasmGuestFramework)' == 'true' AND '$(_NetWasmBuildsModule)' == 'true'">
    <WriteLinesToFile File="$(NetWasmRuntimePackMaterializationIdentityPath)"
                      Lines="target=$(NetWasmTarget);garbageCollector=$(NetWasmGarbageCollector);optimization=$(_NetWasmCanonicalOptimization);initialHeap=$(NetWasmInitialHeapSizeBytes);maximumMemory=$(NetWasmMaximumMemorySizeBytes);assetRoot=$(NetWasmRuntimePackRoot);wasmLd=$(NetWasmWasmLdPath);wasmOpt=$(NetWasmNativeBinaryenWasmOptPath);node=$(NetWasmNodePath);wasmToolsCommand=$(NetWasmWasmToolsCommandPath);wasmToolsModule=$(NetWasmWasmToolsModulePath);sdk=$(NetWasmSdkVersion);compiler=$(NetWasmCompilerVersion);runtime=$(NetWasmRuntimeVersion);runtimePack=$(NetWasmRuntimePackPackageVersion);hostTools=$(NetWasmHostToolsPackageId)@$(NetWasmHostToolsPackageVersion);wasmLdVersion=$(NetWasmWasmLdVersion);wasmOptVersion=$(NetWasmNativeBinaryenWasmOptVersion);wasmToolsVersion=$(NetWasmWasmToolsVersion);nodeVersion=$(NetWasmNodeVersion)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="NetWasmRuntimePackMaterialize"
          DependsOnTargets="NetWasmRuntimePackWriteMaterializationIdentity"
          AfterTargets="NetWasmCompileCoreModule"
          BeforeTargets="NetWasmSdkComponentize;NetWasmSdkValidateFinalArtifactForNoBuild"
          Condition="'$(NetWasmGuestFramework)' == 'true' AND '$(_NetWasmBuildsModule)' == 'true' AND '$(DesignTimeBuild)' != 'true'">
    <!-- The materializer's content cache is authoritative. Timestamp-only target
         skipping cannot detect a replaced archive whose timestamp is preserved. -->
    <Error Code="NWPACK002"
           Condition="'$(NetWasmWasmLdPath)' == '' OR !Exists('$(NetWasmWasmLdPath)')"
           Text="The pinned NetWasm wasm-ld executable is unavailable." />
    <Error Code="NWPACK003"
           Condition="'$(NetWasmWasmToolsCommandPath)' == '' OR !Exists('$(NetWasmWasmToolsCommandPath)') OR '$(NetWasmWasmToolsModulePath)' == '' OR !Exists('$(NetWasmWasmToolsModulePath)')"
           Text="The pinned platform-neutral NetWasm wasm-tools command is unavailable." />
    <ItemGroup>
      <_NetWasmRuntimePackMaterialization Remove="@(_NetWasmRuntimePackMaterialization)" />
    </ItemGroup>
    <RuntimeMaterializationTask PlainCoreModule="$(_NetWasmPlainCoreModule)"
                                RawWasmOutput="$([MSBuild]::ValueOrDefault('$(NetWasmRawWasm)', 'false'))"
                                ManifestPath="$(NetWasmRuntimePackManifestPath)"
                                RuntimeLayoutPath="$(NetWasmRuntimeLayoutPath)"
                                AssetRoot="$(NetWasmRuntimePackRoot)"
                                WasmLdPath="$(NetWasmWasmLdPath)"
                                WasmOptPath="$(NetWasmNativeBinaryenWasmOptPath)"
                                WasmToolsNodePath="$(NetWasmNodePath)"
                                WasmToolsCommandPath="$(NetWasmWasmToolsCommandPath)"
                                WasmToolsModulePath="$(NetWasmWasmToolsModulePath)"
                                NativeWasmToolsPath="$(NetWasmNativeWasmToolsPath)"
                                OutputPath="$(NetWasmRuntimePackMaterializedPath)"
                                LogDirectory="$(NetWasmRuntimePackLogDirectory)"
                                CacheDirectory="$(NetWasmRuntimePackCacheDirectory)"
                                Target="$(NetWasmTarget)"
                                GarbageCollector="$(NetWasmGarbageCollector)"
                                Optimization="$(_NetWasmCanonicalOptimization)"
                                InitialHeapSizeBytes="$(NetWasmInitialHeapSizeBytes)"
                                MaximumMemorySizeBytes="$(NetWasmMaximumMemorySizeBytes)"
                                NativeLibraries="@(NativeLibrary)"
                                EnvImports="@(NetWasmEnvImport)"
                                NativeCallbackObjectPath="$(NetWasmNativeCallbackObjectPath)"
                                SdkVersion="$(NetWasmSdkVersion)"
                                CompilerVersion="$(NetWasmCompilerVersion)"
                                RuntimeVersion="$(NetWasmRuntimeVersion)"
                                RuntimePackVersion="$(NetWasmRuntimePackPackageVersion)"
                                HostToolsPackageId="$(NetWasmHostToolsPackageId)"
                                HostToolsPackageVersion="$(NetWasmHostToolsPackageVersion)"
                                WasmLdVersion="$(NetWasmWasmLdVersion)"
                                WasmOptVersion="$(NetWasmNativeBinaryenWasmOptVersion)"
                                WasmToolsVersion="$(NetWasmWasmToolsVersion)"
                                NodeVersion="$(NetWasmNodeVersion)">
      <Output TaskParameter="RuntimeModules" ItemName="_NetWasmRuntimePackMaterialization" />
    </RuntimeMaterializationTask>
    <Error Code="NWPACK004"
           Condition="'@(_NetWasmRuntimePackMaterialization)' == ''"
           Text="The NetWasm runtime pack did not materialize a runtime module." />
    <ItemGroup>
      <NetWasmComponentRuntime Include="@(_NetWasmRuntimePackMaterialization)" />
      <NetWasmComponentInput Include="@(_NetWasmRuntimePackMaterialization)">
        <Kind>%(_NetWasmRuntimePackMaterialization.Kind)</Kind>
        <WasmTarget>%(_NetWasmRuntimePackMaterialization.WasmTarget)</WasmTarget>
      </NetWasmComponentInput>
    </ItemGroup>
  </Target>

  <Target Name="NetWasmRuntimePackCleanMaterializedRuntime"
          DependsOnTargets="NetWasmRuntimePackResolveOutputPaths"
          BeforeTargets="CoreClean"
          Condition="'$(NetWasmGuestFramework)' == 'true'">
    <Delete Files="$(NetWasmRuntimePackMaterializedPath);$(NetWasmRuntimePackMaterializationIdentityPath)" />
    <RemoveDir Directories="$(NetWasmRuntimePackLogDirectory)"
               Condition="'$(NetWasmRuntimePackLogDirectory)' != '' AND Exists('$(NetWasmRuntimePackLogDirectory)')" />
    <RemoveDir Directories="$(NetWasmRuntimePackCacheDirectory)"
               Condition="'$(NetWasmRuntimePackCacheDirectory)' != '' AND Exists('$(NetWasmRuntimePackCacheDirectory)')" />
  </Target>
</Project>
