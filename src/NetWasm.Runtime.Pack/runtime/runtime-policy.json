{
  "schemaVersion": 1,
  "defaultGarbageCollector": "Compact",
  "alignment": 16,
  "wasmPageSize": 65536,
  "nativeStackSizeBytes": 65536,
  "defaultInitialHeapSizeBytes": 65536,
  "inlineIntents": [
    { "export": "allocate_object", "preference": "Aggressive" },
    { "export": "allocate_object_fallback", "preference": "Aggressive" },
    { "export": "allocate_string", "preference": "Aggressive" },
    { "export": "allocation_run", "preference": "Aggressive" },
    { "export": "allocation_runs_enabled", "preference": "Aggressive" },
    { "export": "allocation_slot", "preference": "Aggressive" },
    { "export": "root_frame_enter", "preference": "Aggressive" },
    { "export": "root_frame_leave", "preference": "Aggressive" },
    { "export": "value_frame_enter", "preference": "Aggressive" },
    { "export": "value_frame_enter_mapped", "preference": "Aggressive" },
    { "export": "value_frame_leave", "preference": "Aggressive" },
    { "export": "value_frame_leave_mapped", "preference": "Aggressive" }
  ],
  "staticNative": {
    "version": 1,
    "features": ["mvp", "mutable-global", "saturating-float-to-int", "sign-extension", "reference-types", "multi-value", "bulk-memory", "simd"],
    "imports": [
      { "module": "netwasm.application.v1", "name": "netwasm.filter", "parameters": ["i32", "ptr", "ptr"], "results": ["i32"], "required": true },
      { "module": "netwasm.application.v1", "name": "netwasm.finalize", "parameters": ["ptr", "i32"], "results": ["i32"], "required": false },
      { "module": "env", "name": "emscripten_notify_memory_growth", "parameters": ["ptr"], "results": [], "required": true },
      { "module": "{prefix}|wasi:cli/environment@0.3", "name": "get-environment", "parameters": ["ptr"], "results": [], "required": true },
      { "module": "{prefix}|wasi:cli/stdout@0.3", "name": "write-via-stream", "parameters": ["i32"], "results": ["i32"], "required": false },
      { "module": "{prefix}|wasi:cli/stderr@0.3", "name": "write-via-stream", "parameters": ["i32"], "results": ["i32"], "required": false },
      { "module": "wasi:cli/stdout@0.3.2", "name": "[stream-new-0]write-via-stream", "parameters": [], "results": ["i64"], "required": false },
      { "module": "wasi:cli/stdout@0.3.2", "name": "[async-lower][stream-write-0]write-via-stream", "parameters": ["i32", "ptr", "ptr"], "results": ["i32"], "required": false },
      { "module": "wasi:cli/stdout@0.3.2", "name": "[stream-drop-writable-0]write-via-stream", "parameters": ["i32"], "results": [], "required": false },
      { "module": "wasi:cli/stdout@0.3.2", "name": "[async-lower][future-read-1]write-via-stream", "parameters": ["i32", "ptr"], "results": ["i32"], "required": false },
      { "module": "wasi:cli/stdout@0.3.2", "name": "[future-drop-readable-1]write-via-stream", "parameters": ["i32"], "results": [], "required": false },
      { "module": "wasi:cli/stderr@0.3.2", "name": "[stream-new-0]write-via-stream", "parameters": [], "results": ["i64"], "required": false },
      { "module": "wasi:cli/stderr@0.3.2", "name": "[async-lower][stream-write-0]write-via-stream", "parameters": ["i32", "ptr", "ptr"], "results": ["i32"], "required": false },
      { "module": "wasi:cli/stderr@0.3.2", "name": "[stream-drop-writable-0]write-via-stream", "parameters": ["i32"], "results": [], "required": false },
      { "module": "wasi:cli/stderr@0.3.2", "name": "[async-lower][future-read-1]write-via-stream", "parameters": ["i32", "ptr"], "results": ["i32"], "required": false },
      { "module": "wasi:cli/stderr@0.3.2", "name": "[future-drop-readable-1]write-via-stream", "parameters": ["i32"], "results": [], "required": false },
      { "module": "$root", "name": "[waitable-set-new]", "parameters": [], "results": ["i32"], "required": false },
      { "module": "$root", "name": "[waitable-join]", "parameters": ["i32", "i32"], "results": [], "required": false },
      { "module": "$root", "name": "[waitable-set-wait]", "parameters": ["i32", "ptr"], "results": ["i32"], "required": false },
      { "module": "{prefix}|wasi:cli/exit@0.3", "name": "exit", "parameters": ["i32"], "results": [], "required": false },
      { "module": "{prefix}|wasi:cli/exit@0.3", "name": "exit-with-code", "parameters": ["i32"], "results": [], "required": false },
      { "module": "{prefix}|wasi:random/random@0.3", "name": "get-random-u64", "parameters": [], "results": ["i64"], "required": false }
    ]
  },
  "targets": {
    "wasm32": {
      "pointerSizeBytes": 4,
      "defaultMaximumMemorySizeBytes": 2147483648,
      "maximumMemorySizeBytes": 2147483648,
      "systemLibraries": [
        "libc_optz.a",
        "libstandalonewasm-nocatch-memgrow.a",
        "libc.a",
        "libemmalloc.a",
        "libclang_rt.builtins.a"
      ]
    },
    "wasm64": {
      "pointerSizeBytes": 8,
      "defaultMaximumMemorySizeBytes": 8589934592,
      "maximumMemorySizeBytes": 8589934592,
      "systemLibraries": [
        "libc_optz.a",
        "libstandalonewasm-nocatch-memgrow.a",
        "libc.a",
        "libemmalloc.a",
        "libclang_rt.builtins.a"
      ]
    }
  }
}
