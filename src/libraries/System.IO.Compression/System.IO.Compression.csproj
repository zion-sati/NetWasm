<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <StrongNameKeyId>ECMA</StrongNameKeyId>
    <AssemblyName>System.IO.Compression</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Interop.zlib's LibraryImport declarations, generated as upstream generates them. -->
    <NetWasmLibraryImportGenerator>$(NETCoreTargetingPackRoot)/Microsoft.NETCore.App.Ref/$(BundledNETCoreAppPackageVersion)/analyzers/dotnet/cs/Microsoft.Interop.LibraryImportGenerator.dll</NetWasmLibraryImportGenerator>
    <NetWasmInteropSourceGeneration>$(NETCoreTargetingPackRoot)/Microsoft.NETCore.App.Ref/$(BundledNETCoreAppPackageVersion)/analyzers/dotnet/cs/Microsoft.Interop.SourceGeneration.dll</NetWasmInteropSourceGeneration>
  </PropertyGroup>

  <ItemGroup>
    <Analyzer Include="$(NetWasmLibraryImportGenerator)" />
    <Analyzer Include="$(NetWasmInteropSourceGeneration)" />
  </ItemGroup>

  <ItemGroup>
