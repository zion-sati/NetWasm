<Project>
  <Import Project="../../Directory.Build.targets" />
  <ItemGroup>
    <ProjectReference Include="$(NetWasmCoreLibProject)" />
    <Compile Include="$(NetWasmLibrariesRoot)AssemblyAttributes.cs" Link="AssemblyAttributes.cs" />
  </ItemGroup>
  <!-- The library's forwarders to CoreLib, as upstream's partial facade has them (generated by
       framework-split/forwards). Removed first, so a project that compiles its files by default has it once. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/$(AssemblyName).Forwards.cs')">
    <Compile Remove="$(MSBuildProjectDirectory)/$(AssemblyName).Forwards.cs" />
    <Compile Include="$(MSBuildProjectDirectory)/$(AssemblyName).Forwards.cs" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Upstream's public keys (the snk folder holds them as dotnet/arcade names them). -->
    <AssemblyOriginatorKeyFile Condition="'$(StrongNameKeyId)' == 'Microsoft'">$(NetWasmLibrariesRoot)snk/MSFT.snk</AssemblyOriginatorKeyFile>
    <AssemblyOriginatorKeyFile Condition="'$(StrongNameKeyId)' == 'Open'">$(NetWasmLibrariesRoot)snk/Open.snk</AssemblyOriginatorKeyFile>
    <AssemblyOriginatorKeyFile Condition="'$(StrongNameKeyId)' == 'ECMA'">$(NetWasmLibrariesRoot)snk/ECMA.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
  </PropertyGroup>
  <Target Name="NetWasmLibraryRequireKey" BeforeTargets="CoreCompile">
    <Error Condition="'$(AssemblyOriginatorKeyFile)' == '' OR !Exists('$(AssemblyOriginatorKeyFile)')"
           Text="StrongNameKeyId '$(StrongNameKeyId)' names no upstream public key." />
  </Target>
  <PropertyGroup Condition="'$(CLSCompliant)' == 'false'">
    <DefineConstants>$(DefineConstants);NETWASM_CLS_NONCOMPLIANT</DefineConstants>
  </PropertyGroup>
</Project>
