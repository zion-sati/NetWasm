    <AssemblyName>System.Security.Cryptography</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Interop.Crypto's LibraryImport declarations, generated as upstream generates them. -->
    <NetWasmLibraryImportGenerator>$(NETCoreTargetingPackRoot)/Microsoft.NETCore.App.Ref/$(BundledNETCoreAppPackageVersion)/analyzers/dotnet/cs/Microsoft.Interop.LibraryImportGenerator.dll</NetWasmLibraryImportGenerator>
