<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework>netwasm0.1</TargetFramework>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>page;worker</NetWasmJavaScriptHosts>
    <AssemblyName>BrowserHosts</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <NetWasmJavaScriptModule Include="labels.mjs" Module="app.labels" />
    <Content Include="index.html;app.mjs" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
