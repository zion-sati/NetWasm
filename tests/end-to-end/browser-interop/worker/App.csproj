<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework>netwasm0.1</TargetFramework>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>worker</NetWasmJavaScriptHosts>
    <AssemblyName>BrowserWorker</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <NetWasmJavaScriptModule Include="notifications.mjs" Module="app.host" />
    <NetWasmJavaScriptModule Include="optional.mjs" Module="app.optional" />
    <NetWasmJavaScriptModule Include="../shared/cells.mjs" Module="app.cells" />
    <Compile Include="../shared/InteropCells.cs" />
    <Content Include="../shared/check-cells.mjs" Link="check-cells.mjs" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="index.html;app.mjs" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
