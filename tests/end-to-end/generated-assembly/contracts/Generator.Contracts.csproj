<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.0]" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="[10.0.0]" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.DependencyInjection/Generated/*.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.DependencyInjection/ServiceProviderOptions.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.DependencyInjection/ServiceProvider.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.DependencyInjection/ServiceCollectionContainerBuilderExtensions.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.DependencyInjection/DefaultServiceProviderFactory.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.DependencyInjection/ServiceLookup/*.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.DependencyInjection.Abstractions/Microsoft/Extensions/DependencyInjection/Generated/*.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.DependencyInjection.Abstractions/Microsoft/Extensions/DependencyInjection/IGeneratedActivator.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.DependencyInjection.Abstractions/Microsoft/Extensions/DependencyInjection/ActivatorUtilities.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.DependencyInjection.Abstractions/Microsoft/Extensions/DependencyInjection/ObjectFactory.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.Configuration.Binder/Microsoft/Extensions/Configuration/*.cs" />
    <Compile Include="$(LibrariesSnapshot)/src/NetWasm.Microsoft.Extensions.Configuration.Abstractions/Microsoft/Extensions/Configuration/IConfigurationSectionValueAccessor.cs" />
    <Compile Include="Repository.cs" />
  </ItemGroup>
</Project>
