<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10.0 by default; the pay-for-use test builds it with .NET 11's generator, the one NetWasm.App.Ref ships. -->
    <StjFixtureTargetFramework Condition="'$(StjFixtureTargetFramework)' == ''">net10.0</StjFixtureTargetFramework>
    <TargetFramework>$(StjFixtureTargetFramework)</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- global.json pins the ordinary SDK generator. The pinned
         dotnet/runtime-corelib baseline is deae2e32bf0e018e09d64597b7c59b62b73bb3ce
         (.NET 11.0.0); source intentionally uses their common STJ contract. -->

    <!-- The acceptance test checks these files to prove that the ordinary SDK
         System.Text.Json generator ran during the host build. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SourceGenerationFixture.cs" />
  </ItemGroup>
</Project>
