<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net11.0;netwasm0.1</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <TUnitSourceGenerationMode>ClosedWorldCatalog</TUnitSourceGenerationMode>
    <!-- SYSLIB0014 and CS0618: the legacy request APIs under test are obsolete. -->
    <NoWarn>$(NoWarn);TUnit0034;TUnit0038;SYSLIB0014;CS0618</NoWarn>
    <DisableImplicitFrameworkReferences Condition="'$(TargetFramework)' == 'net11.0'">false</DisableImplicitFrameworkReferences>
    <NoStdLib Condition="'$(TargetFramework)' == 'net11.0'">false</NoStdLib>
    <NoStandardLibraries Condition="'$(TargetFramework)' == 'net11.0'">false</NoStandardLibraries>
    <NoCompilerStandardLib Condition="'$(TargetFramework)' == 'net11.0'">false</NoCompilerStandardLib>
    <DisableStandardFrameworkResolution Condition="'$(TargetFramework)' == 'net11.0'">true</DisableStandardFrameworkResolution>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="Xunit" />
    <NetWasmClockGrant Include="wall" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <PackageReference Include="NetWasm.TUnit" Version="[$(NetWasmTUnitPackageVersion)]" />
  </ItemGroup>
</Project>
