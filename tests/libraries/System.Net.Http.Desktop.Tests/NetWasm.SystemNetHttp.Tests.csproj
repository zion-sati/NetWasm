<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- The package sources take pointers, as upstream System.Net.Http does. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);NETWASM;TARGET_WASI</DefineConstants>
    <NoWarn>$(NoWarn);CS0436;CS3021</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- System.Net.Http's sources, compiled for desktop over a test transport instead of wasi:http. -->
    <Compile Include="../../../src/libraries/System.Net.Http/**/*.cs"
             Exclude="../../../src/libraries/System.Net.Http/bin/**/*.cs;../../../src/libraries/System.Net.Http/obj/**/*.cs;../../../src/libraries/System.Net.Http/AssemblyInfo.cs;../../../src/libraries/System.Net.Http/System/Net/Http/WasiHttp/WasiHttpBindings.g.cs;../../../src/libraries/System.Net.Http/System/Net/Http/WasiHttp/WasiHttpBindingClient.cs;../../../src/libraries/System.Net.Http/System/Net/Http/WasiHttp/WasiHttpTransportComposition.cs"
             LinkBase="System.Net.Http" />
  </ItemGroup>
</Project>
