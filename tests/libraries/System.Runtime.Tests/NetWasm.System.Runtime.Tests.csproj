<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net11.0;netwasm0.1</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <RootNamespace>NetWasm.CoreLib.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <TUnitSourceGenerationMode>ClosedWorldCatalog</TUnitSourceGenerationMode>
    
    <NoWarn>$(NoWarn);TUnit0034;TUnit0038</NoWarn>
    <DisableImplicitFrameworkReferences Condition="'$(TargetFramework)' == 'net11.0'">false</DisableImplicitFrameworkReferences>
    <NoStdLib Condition="'$(TargetFramework)' == 'net11.0'">false</NoStdLib>
    <NoStandardLibraries Condition="'$(TargetFramework)' == 'net11.0'">false</NoStandardLibraries>
    <NoCompilerStandardLib Condition="'$(TargetFramework)' == 'net11.0'">false</NoCompilerStandardLib>
    <DisableStandardFrameworkResolution Condition="'$(TargetFramework)' == 'net11.0'">true</DisableStandardFrameworkResolution>
    <!-- The converted harness fixtures: desktop .NET 11 builds them with DESKTOP_ORACLE, as the harness's oracle did. -->
    <DefineConstants Condition="'$(TargetFramework)' == 'net11.0'">$(DefineConstants);DESKTOP_ORACLE</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS8321;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625;SYSLIB0003;SYSLIB0011;SYSLIB0014;SYSLIB0021;SYSLIB0023;SYSLIB0039;SYSLIB0050;SYSLIB0051</NoWarn>
    <!-- NetWasm's globalization is invariant, so desktop .NET 11, the oracle, runs in invariant mode too. -->
    <InvariantGlobalization Condition="'$(TargetFramework)' == 'net11.0'">true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="Xunit" />
    <!-- Some converted fixtures read the current time. -->
    <NetWasmClockGrant Include="wall" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <PackageReference Include="NetWasm.TUnit" Version="[$(NetWasmTUnitPackageVersion)]" />
  </ItemGroup>
</Project>
