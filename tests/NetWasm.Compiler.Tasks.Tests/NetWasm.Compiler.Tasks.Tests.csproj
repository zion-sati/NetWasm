<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="coverlet.msbuild" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NetWasm.Compiler.Core/NetWasm.Compiler.Core.csproj" />
    <ProjectReference Include="../../src/NetWasm.Compiler/NetWasm.Compiler.csproj" />
    <ProjectReference Include="../../src/NetWasm.Compiler.Tasks/NetWasm.Compiler.Tasks.csproj" />
    <!-- nwc.dll, which the compile task's tests run. -->
    <ProjectReference Include="../../src/NetWasm.Compiler.Cli/NetWasm.Compiler.Cli.csproj" />
    <ProjectReference Include="../../src/NetWasm.Runtime.Pack/NetWasm.Runtime.Pack.csproj" />
    <ProjectReference Include="../../src/NetWasm.CoreLib/NetWasm.CoreLib.csproj"
                      ReferenceOutputAssembly="false"
                      AdditionalProperties="Configuration=Release" />
    <ProjectReference Include="Fixtures/ManagedExecutable/ManagedExecutable.csproj" />
    <ProjectReference Include="Fixtures/AsyncManagedExecutable/AsyncManagedExecutable.csproj" />
    <ProjectReference Include="Fixtures/AsyncVoidManagedExecutable/AsyncVoidManagedExecutable.csproj" />
    <ProjectReference Include="Fixtures/AsyncStringArgumentsManagedExecutable/AsyncStringArgumentsManagedExecutable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TestAssets compiles fixtures against NetWasm.App's assemblies, which this collects. -->
    <ProjectReference Include="../../src/NetWasm.App.Runtime/NetWasm.App.Runtime.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../TestInfrastructure/TestAssets.cs" Link="TestSupport/TestAssets.cs" />
    <Compile Include="../TestInfrastructure/DotNetHost.cs" Link="DotNetHost.cs" />
    <Compile Remove="Fixtures/**/*.cs" />
    <None Include="IntegrationAssets/NativeRuntimeMetadata.proj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/NetWasm.Compiler.Tasks/buildTransitive/NetWasm.Compiler.Tasks.targets"
          Link="IntegrationAssets/NetWasm.Compiler.Tasks.targets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../global.json" Link="IntegrationAssets/global.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
