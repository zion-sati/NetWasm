<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../src/NetWasm.Sdk/Sdk/NetWasm.NativeLibraries.targets"
          Link="IntegrationAssets/NetWasm.NativeLibraries.targets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../global.json" Link="IntegrationAssets/global.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
