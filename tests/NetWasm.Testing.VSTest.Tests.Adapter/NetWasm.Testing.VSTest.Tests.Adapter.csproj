<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NetWasm.Testing.VSTest.Tests.Adapter</AssemblyName>
    <RootNamespace>NetWasm.Testing.VSTest.Tests.Adapter</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>NetWasm.Testing.VSTest.Tests.Adapter</PackageId>
    <Version>0.2.0-preview.2</Version>
    <Description>Package-only qualification adapter for the generic NetWasm VSTest bridge.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsTestProject>false</IsTestProject>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectSyntheticNetWasmTestAdapter</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="Xunit" />
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel"
                      Version="18.0.1"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive/NetWasm.Testing.VSTest.Tests.Adapter.targets"
          Pack="true"
          PackagePath="buildTransitive/NetWasm.Testing.VSTest.Tests.Adapter.targets" />
  </ItemGroup>
  <Target Name="CollectSyntheticNetWasmTestAdapter"
          Returns="@(TfmSpecificPackageFile)"
          Condition="'$(TargetFramework)' == 'net10.0'">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)"
                              PackagePath="tools/net10.0/any/" />
    </ItemGroup>
  </Target>
</Project>
